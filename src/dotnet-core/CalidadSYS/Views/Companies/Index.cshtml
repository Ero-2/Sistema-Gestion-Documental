@model List<CalidadSYS.ViewModels.CompanyRowViewModel>
@{
    ViewData["Title"] = "Empresas";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0 fw-bold"><i class="bi bi-buildings me-2 text-primary"></i>Empresas</h5>
    <a asp-action="Create" class="btn btn-sm btn-primary">
        <i class="bi bi-plus-lg me-1"></i> Nueva empresa
    </a>
</div>

@if (TempData["Success"] is string ok)
{
    <div class="alert alert-success py-2 small">@ok</div>
}

<div class="row g-3">
    @foreach (var c in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="badge bg-light text-dark border">@c.Code</span>
                            <h6 class="fw-bold mt-2 mb-1">@c.Name</h6>
                            <div class="text-muted small">@(c.TaxId ?? "—")</div>
                        </div>
                        <span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">
                            @(c.IsActive ? "Activa" : "Inactiva")
                        </span>
                    </div>
                    <div class="d-flex gap-3 mt-3 small text-muted">
                        <span><i class="bi bi-file-earmark-text me-1"></i>@c.DocumentCount docs</span>
                        <span><i class="bi bi-people me-1"></i>@c.UserCount usuarios</span>
                    </div>
                    <a asp-action="Documents" asp-route-id="@c.CompanyId"
                       class="btn btn-sm btn-outline-primary mt-3 w-100">
                        <i class="bi bi-folder2-open me-1"></i> Ver documentos
                    </a>
                </div>
            </div>
        </div>
    }
    @if (!Model.Any())
    {
        <div class="col-12"><p class="text-muted">Sin empresas registradas.</p></div>
    }
</div>
