# Force LF line endings for shell scripts — prevents CRLF breaking Linux containers
*.sh    text eol=lf
*.bash  text eol=lf

# Windows scripts stay CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Docker / config files — LF
Dockerfile*         text eol=lf
docker-compose*.yml text eol=lf
*.conf              text eol=lf
*.sql               text eol=lf
*.js                text eol=lf

# Binary files
*.png  binary
*.jpg  binary
*.pdf  binary
*.zip  binary
